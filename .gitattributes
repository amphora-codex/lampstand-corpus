sources/**/*.zip filter=lfs diff=lfs merge=lfs -text
sources/**/*.json filter=lfs diff=lfs merge=lfs -text
sources/**/*.usfm filter=lfs diff=lfs merge=lfs -text
sources/**/*.sfm filter=lfs diff=lfs merge=lfs -text
sources/**/*.txt filter=lfs diff=lfs merge=lfs -text
sources/**/*.xml filter=lfs diff=lfs merge=lfs -text
sources/**/*.usx filter=lfs diff=lfs merge=lfs -text

# The provenance manifest is small, human-readable, and meant to be read/diffed
# directly in the repo — keep it as normal text, not LFS. (Overrides the broad
# sources/**/*.json LFS rule above, which targets large source data files.)
sources/manifest.json text -filter -diff -merge
sources/confessions/manifest.json text -filter -diff -merge
sources/commentaries/manifest.json text -filter -diff -merge
